GOONG_MAP_CALC_API_KEY=
GOONG_MAP_RENDER_API_KEY=
GOONG_DOMAIN=https://rsapi.goong.io
GOONG_PLAYGROUND_KEY=
SERP_MAP_API=
# Shared outgoing request budgets, reset at midnight UTC.
GOONG_DAILY_REQUEST_LIMIT=10000
SERP_DAILY_REQUEST_LIMIT=100
HTTP_ADDR=:8080

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Singapore
DB_URL

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL

LEG_CACHE_TTL_SECONDS=86400
PLACE_CACHE_TTL_SECONDS=86400
TRAVEL_TTL_SECONDS=86400

# Run a separate `worker` process for redirect jobs.
TRACKING_CHECKPOINT_INTERVAL_SECONDS=5

USER_NAME=
USER_EMAIL=
USER_PASSWORD=

# Three distinct, randomly generated secrets, each at least 32 bytes.
SECRET_JWT=
SECRET_REFRESH_JWT=
SECRET_MAIL_JWT=

APP_PUBLIC_URL=http://localhost:8080
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Road2D

# Private Cloudflare R2 bucket. No public URL or custom domain is needed.
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Existing R2_ACCESS_TOKEN and R2_SECRET_ACCESS_TOKEN names are also accepted.
# Optional S3 endpoint override for jurisdiction-specific buckets.
R2_ENDPOINT=

# Decimal bytes: image 5 MB, video 25 MB, audio 5 MB.
MEDIA_MAX_IMAGE_BYTES=5000000
MEDIA_MAX_VIDEO_BYTES=25000000
MEDIA_MAX_AUDIO_BYTES=5000000
